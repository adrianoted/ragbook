# Server
HOST=0.0.0.0
PORT=8000
# Docker only: host port the app is published on (container listens on 8000).
# Defaults to 8001 so it never clashes with a native `python run.py` on 8000.
# APP_PORT=8001
DEBUG=false
ENVIRONMENT=development
LOG_LEVEL=info

# Embedding
# NOTE (Docker on macOS/Windows): no GPU in the container, so this 4B model runs
# on CPU and ingest often exceeds the UI timeout ("timed out" in the Upload tab).
# A lighter model, e.g. intfloat/multilingual-e5-small, keeps Docker usable — but
# it changes the vector dimension, so existing collections must be re-ingested.
# See README "Performance Limits in Docker".
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B

# Vector Store: "faiss" | "chroma" | "pinecone" | "qdrant"
VECTOR_STORE=faiss

# LLM: gemini | ollama
# LLM Model: gemini-2.5-flash | gemini-2.5-flash-lite | qwen3:4b | qwen3:14b | qwen3:30b | qwen3:32b
# NOTE (ollama): the model must match the one pulled in Ollama
# (`ollama pull <model>`; in Docker: `docker compose exec ollama ollama pull <model>`).
# On CPU-only Docker, qwen3:4b is recommended.

LLM_PROVIDER=ollama
LLM_MODEL=qwen3:14b

LLM_TEMPERATURE=0.3
LLM_NUM_CTX=8192
LLM_THINK=false
LLM_TIMEOUT=300.0

# Chunking: "recursive" | "semantic"
CHUNKER=semantic
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
MIN_SCORE=0.15
# Threshold on cross-encoder sigmoid scores (post-rerank). Too strict -> 0.2,
# too permissive -> 0.5. Calibration guide: docs/09, "Tuning the threshold".
RERANK_MIN_SCORE=0.3
MAX_RESULTS_PER_DOCUMENT=2
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Search: "vector" | "tfidf" | "hybrid"
SEARCH_STRATEGY=hybrid
HYBRID_VECTOR_WEIGHT=0.7
# Fusion mode for hybrid search: "weighted" (linear combination) | "rrf" (Reciprocal Rank Fusion)
# Note: with RRF, raw scores are ~1/60·n — well below the default MIN_SCORE=0.15.
# When RERANKER_ENABLED=true (default), filtering uses sigmoid reranker scores and is not affected.
# If you disable the reranker and use RRF, lower MIN_SCORE (e.g. 0.01) to avoid empty results.
FUSION=weighted

# Lexical backend: "tfidf" (sklearn, default) | "bm25" (rank-bm25)
# WARNING: switching backend with existing collections leaves the index empty — re-ingest required.
# Note on MIN_SCORE: BM25 scores are not bounded [0,1]; with RERANKER_ENABLED=true (default)
# filtering uses sigmoid reranker scores and is unaffected. If you disable the reranker, lower
# MIN_SCORE (e.g. 0.01) to avoid empty results.
LEXICAL_BACKEND=tfidf
BM25_INDEX_PATH=data/bm25_indexes

# UI
# Seconds between two polls of an async ingest job in the Upload tab.
# INGEST_POLL_INTERVAL=5

# Paths
FAISS_INDEX_PATH=data/faiss_indexes
CHROMA_PERSIST_DIR=data/chroma_store
TFIDF_INDEX_PATH=data/tfidf_indexes
SQLITE_DB_PATH=data/ragbook.db
UPLOAD_DIR=data/uploads

# API Keys
# Gemini: set GOOGLE_API_KEY and LLM_PROVIDER=gemini above.
GOOGLE_API_KEY=
# Native setup (default): Ollama on this machine.
OLLAMA_BASE_URL=http://localhost:11434
# Docker full stack (`docker compose up`): use the compose `ollama` service instead:
# OLLAMA_BASE_URL=http://ollama:11434
# Docker app-only (`docker compose up app`) with Ollama on the host:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ragbook
# PINECONE_CLOUD=aws         # default: aws (replaces deprecated PINECONE_ENVIRONMENT)
# PINECONE_REGION=us-east-1  # default: us-east-1

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# CORS (comma-separated list of allowed origins; defaults to localhost only)
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

